#!/usr/bin/env bash
# Standard pre-commit gate. GENERATED by _shared/tools/generate_hooks.py from
# release.json; edit the generator, not this file. Installed by
#     git config core.hooksPath .githooks
# Bypass in an emergency with git commit --no-verify, and say so in the commit.
set -eu
ROOT="$(git rev-parse --show-toplevel)"; cd "$ROOT"
PY="${PYTHON:-python}"; command -v "$PY" >/dev/null 2>&1 || PY=python3
PKG="Lineuparr"

echo "[pre-commit] byte-compiling $PKG/*.py"
shopt -s nullglob; files=("$PKG"/*.py); shopt -u nullglob
if [ "${#files[@]}" -eq 0 ]; then echo "[pre-commit] FAIL: no .py files under $PKG"; exit 1; fi
"$PY" -m py_compile "${files[@]}"

echo "[pre-commit] version sync"
"$PY" scripts/check_version_sync.py

if "$PY" -m ruff --version >/dev/null 2>&1; then
  echo "[pre-commit] ruff gate (E9,F63,F7,F82)"
  "$PY" -m ruff check "$PKG" --select E9,F63,F7,F82
else
  echo "[pre-commit] ruff not installed for $PY; lint gate skipped (CI enforces it)"
fi

# Lineuparr rule: no em dash (U+2014) in any staged content. Written as an
# escape so this file never carries the character itself.
emdash="$(printf '\342\200\224')"
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  n="$(git show ":$f" 2>/dev/null | grep -c "$emdash" || true)"
  case "$n" in ''|0) ;; *) echo "[pre-commit] FAIL: em dash in staged file $f"; exit 1 ;; esac
done

if [ -d tests ]; then
  echo "[pre-commit] tests"
  "$PY" -m pytest -q -x -p no:cacheprovider
fi
echo "[pre-commit] OK"
