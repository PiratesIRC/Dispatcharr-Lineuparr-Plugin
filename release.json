{
  "repo": "Lineuparr",
  "tag_prefix": "v",
  "default_branch": "main",
  "remote": "origin",
  "changelog": "CHANGELOG.md",
  "version_attr_regex": null,
  "hub_mode": "standard",
  "publish_model": "tag",
  "publish_branch": null,
  "python": "3.12",
  "extra_gates": [
    "python .github/scripts/validate_plugin.py",
    "python .github/scripts/check_core_parity.py",
    "python .github/scripts/check_client_parity.py",
    "python .github/scripts/check_matcher_golden.py"
  ],
  "tests_tracked": true,
  "package_dir": "Lineuparr",
  "plugin_key": "lineuparr",
  "zip_name": "Lineuparr.zip",
  "hub_slug": "lineuparr",
  "version_files": [
    {
      "path": "Lineuparr/plugin.json",
      "regex": "\"version\"\\s*:\\s*\"([^\"]+)\""
    },
    {
      "path": "Lineuparr/plugin.py",
      "regex": "^\\s*PLUGIN_VERSION\\s*=\\s*\"([^\"]+)\""
    }
  ],
  "_note": "Contract read by scripts/*.py, .githooks, .github/workflows and the workspace release, pre-release-qa, deploy-plugin and hub-release skills. Values marked null are unknown or not applicable. Keep keys in this order."
}
